{
  "name": "isla-perdida",
  "productName": "Isla Perdida",
  "version": "2.2.0",
  "description": "Supervivencia en un archipiélago con barcos, tribus y Frutas del Abismo. Juego LAN amistoso y versus.",
  "main": "desktop/main.js",
  "author": "BVR Studio",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "build": "node scripts/build-desktop.js",
    "web": "node scripts/build-web.js",
    "server": "node desktop/server.js 8080"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.21.3",
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.islaperdida.juego",
    "productName": "Isla Perdida",
    "copyright": "© 2026 BVR Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "js/**/*",
      "css/**/*",
      "lib/**/*",
      "img/**/*",
      "audio/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "LEEME.txt",
        "to": "LEEME.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Isla-Perdida-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Isla Perdida",
      "uninstallDisplayName": "Isla Perdida",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Pro1Code",
        "repo": "isla-perdida",
        "releaseType": "release"
      }
    ]
  }
}
